# ---------- shared PDF helpers ----------
def wrap(c,text,x,y,w,font='Helvetica',size=9,leading=11,max_lines=None):
    words=text.split(); lines=[]; line=''
    for word in words:
        test=word if not line else line+' '+word
        if stringWidth(test,font,size)<=w: line=test
        else:
            if line: lines.append(line)
            line=word
    if line: lines.append(line)
    if max_lines: lines=lines[:max_lines]
    c.setFont(font,size); c.setFillColor(BLACK)
    yy=y
    for s in lines: c.drawString(x,yy,s); yy-=leading
    return yy

def header(c,title,subtitle,page=None):
    W,H=LETTER
    c.setFillColor(NAVY); c.rect(0,H-0.70*inch,W,0.70*inch,fill=1,stroke=0)
    c.setFillColor(WHITE); c.setFont('Helvetica-Bold',15); c.drawString(.45*inch,H-.31*inch,title)
    c.setFont('Helvetica',8.5); c.drawString(.45*inch,H-.50*inch,subtitle)
    if page:
        c.setFont('Helvetica-Bold',8); c.drawRightString(W-.45*inch,H-.42*inch,f'PAGE {page}')

def student_info(c,y):
    c.setFillColor(BLACK); c.setStrokeColor(BLACK); c.setLineWidth(.6); c.setFont('Helvetica',8)
    c.drawString(.45*inch,y,'NAME:')
    c.line(.9*inch,y-2,3.2*inch,y-2)
    c.drawString(3.45*inch,y,'PERIOD:')
    c.line(4.03*inch,y-2,4.8*inch,y-2)
    c.drawString(5.05*inch,y,'DATE:')
    c.line(5.42*inch,y-2,7.92*inch,y-2)

def section(c,y,title,subtitle=None):
    c.setFillColor(LT); c.setStrokeColor(BLACK); c.setLineWidth(.6)
    c.rect(.45*inch,y-.30*inch,7.6*inch,.30*inch,fill=1,stroke=1)
    c.setFillColor(BLACK); c.setFont('Helvetica-Bold',10); c.drawString(.57*inch,y-.20*inch,title)
    if subtitle:
        c.setFont('Helvetica',7); c.drawRightString(7.93*inch,y-.20*inch,subtitle)
    return y-.38*inch

def table(c,x,y,widths,row_h,headers,rows,font=7.5):
    total=sum(widths); n=1+len(rows)
    c.setLineWidth(.55); c.setStrokeColor(BLACK)
    c.setFillColor(LT); c.rect(x,y-row_h,total,row_h,fill=1,stroke=1)
    xx=x
    for w in widths[:-1]: xx+=w; c.line(xx,y-row_h,xx,y)
    c.setFillColor(BLACK); c.setFont('Helvetica-Bold',font)
    xx=x
    for h,w in zip(headers,widths): c.drawCentredString(xx+w/2,y-row_h*.66,h); xx+=w
    yy=y-row_h
    for r in rows:
        c.setFillColor(WHITE); c.rect(x,yy-row_h,total,row_h,fill=1,stroke=1)
        xx=x
        for w in widths[:-1]: xx+=w; c.line(xx,yy-row_h,xx,yy)
        c.setFillColor(BLACK); c.setFont('Helvetica',font)
        xx=x
        for val,w in zip(r,widths):
            if val: c.drawCentredString(xx+w/2,yy-row_h*.66,str(val))
            xx+=w
        yy-=row_h
    return yy

